
<html>
    <%- include('./partials/head') %>
    <header>   
        <a class="add-message" href="/new">Add a message +</a>
    </header>
    <div class="messages-container">
        <h2><%= title %></h2>
        <hr>
        <% if (messages.length === 0) { %>
            <p>No messages at the moment...</p>
        <% } else { %>
            <div class="messages-list">
                <% messages.forEach((message) => { %>
                    <div class="message">
                        <p class="message-text"><%= message.text %></p>
                        <p class="message-user"><%= message.username %></p>
                        <p class="message-date"><%= message.added.toDateString() %></p>
                        <a class="message-open" href="/<%= message.id %>">OPEN</a>
                        <form class="message-delete" action="/<%=message.id %>/delete" method="post">
                            <button type="submit">
                                <span class="material-symbols-outlined">
                                delete
                                </span>
                            </button>
                        </form>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</html>